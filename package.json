{
  "name": "customer-test-api",
  "version": "1.0.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests test/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --runInBand test/integration",
    "migrate": "node scripts/migrate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Customer Portal API - Fastify + Sequelize + Awilix",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "imports": {
    "#service/*": "./src/services/*",
    "#repositories/*": "./src/repositories/*",
    "#controller/*": "./src/controller/*",
    "#schemas/*": "./src/schemas/*",
    "#routers/*": "./src/routers/*",
    "#models/*": "./src/models/*",
    "#common/*": "./src/common/*",
    "#configs/*": "./src/configs/*",
    "#constants/*": "./src/common/constants/*"
  },
  "dependencies": {
    "@fastify/autoload": "^6.4.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "awilix": "^13.0.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.0",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "square": "^45.0.1",
    "stripe": "^22.3.2",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5"
  }
}
